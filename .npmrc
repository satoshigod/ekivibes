# Reintentos automáticos para evitar el error 429 (Too Many Requests)
fetch-retries=5
fetch-retry-factor=3
fetch-retry-mintimeout=15000
fetch-retry-maxtimeout=120000
fetch-timeout=600000
# Menos peticiones en paralelo = menos probabilidad de rate limit
maxsockets=3
# No abortar por warnings de dependencias
legacy-peer-deps=true
